{
  "name": "neuclip",
  "version": "0.0.0",
  "description": "An open library of Remotion animation clips with a schema-driven in-browser editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meetportal/cliplibrary.git"
  },
  "homepage": "https://github.com/meetportal/cliplibrary#readme",
  "bugs": "https://github.com/meetportal/cliplibrary/issues",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test tests --timeout 20000",
    "test:coverage": "bun test tests --coverage --timeout 20000",
    "test:e2e": "playwright test",
    "render": "bun run src/render/render-all.ts",
    "render-one": "bun run src/render/render-one.ts",
    "render:posters": "bun run src/render/render-posters.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-database.ts",
    "render:sites": "bun run src/render/render-sites.ts",
    "check:comments": "bun run scripts/strip-comments.ts --check",
    "check:em-dashes": "bun run scripts/check-em-dashes.ts",
    "check:repository": "bun run scripts/check-repository.ts",
    "knip": "knip",
    "audit": "bun audit --audit-level=high --ignore=GHSA-fc5q-39xc-vjpf",
    "verify": "bun run lint && bun run check:comments && bun run check:em-dashes && bun run check:repository && bun run knip && bun run typecheck && bun run test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.180",
    "@clerk/mcp-tools": "0.9.0",
    "@clerk/nextjs": "7.10.2",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.2.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/player": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@remotion/three": "4.0.544",
    "@remotion/web-renderer": "4.0.544",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-virtual": "3.14.26",
    "ai": "7.0.176",
    "audiobuffer-to-wav": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "drizzle-orm": "0.45.4",
    "eventsource-parser": "4.1.3",
    "fast-json-patch": "3.1.1",
    "jspdf": "4.2.1",
    "konva": "10.9.1",
    "lucide": "1.75.0",
    "lucide-react": "1.75.0",
    "minisearch": "7.2.0",
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "remotion": "4.0.544",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "tone": "15.1.22",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@clerk/backend": "3.30.0",
    "@clerk/testing": "2.3.1",
    "@electric-sql/pglite": "0.5.16",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/audiobuffer-to-wav": "1.0.4",
    "@types/bun": "1.4.4",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxc-parser": "0.159.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "picomatch@4.0.7": "patches/picomatch@4.0.7.patch"
  }
}
